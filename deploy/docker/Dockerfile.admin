# admin-web 多阶段：node 构建 → nginx 运行（静态 + 反代）。构建上下文 = 仓库根。
# syntax=docker/dockerfile:1
ARG REGISTRY=
FROM ${REGISTRY}node:22-alpine AS build
ARG REGISTRY
# 国内服务器：npm/pnpm 走 npmmirror（D-026 同理）
RUN npm config set registry https://registry.npmmirror.com && npm i -g pnpm@11 --registry=https://registry.npmmirror.com
WORKDIR /repo
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc* ./
COPY packages/admin-web/package.json packages/admin-web/
COPY packages/screen-web/package.json packages/screen-web/
COPY packages/mobile-h5/package.json packages/mobile-h5/
COPY packages/map-render/package.json packages/map-render/
# esbuild 平台二进制经 optionalDependencies 安装，postinstall 可跳过（pnpm11 非交互批准兼容问题）
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY packages/admin-web packages/admin-web
COPY packages/screen-web packages/screen-web
COPY packages/mobile-h5 packages/mobile-h5
COPY packages/map-render packages/map-render
# 部署挂在 nginx /admin/ 路径下：资源前缀 /admin/assets/（本地 dev 走 / 不受影响）
ENV VITE_BASE=/admin/
RUN pnpm --filter @sage/admin-web build

# 公网大屏入口（U1）：凭据为设备专用口令（A17，独立于管理口令，设备角色最小权限）
ARG VITE_SCREEN_USERNAME=screen-f1-01
ARG VITE_SCREEN_PASSWORD
ARG VITE_VENUE_ID=1
ENV VITE_BASE=/screen/ VITE_SCREEN_USERNAME=$VITE_SCREEN_USERNAME VITE_SCREEN_PASSWORD=$VITE_SCREEN_PASSWORD VITE_VENUE_ID=$VITE_VENUE_ID
RUN pnpm --filter @sage/screen-web build
ENV VITE_BASE=/m/
RUN pnpm --filter @sage/mobile-h5 build

FROM ${REGISTRY}nginx:1.27-alpine AS runtime
COPY deploy/nginx/admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/packages/admin-web/dist /usr/share/nginx/html/admin
COPY --from=build /repo/packages/screen-web/dist /usr/share/nginx/html/screen
COPY --from=build /repo/packages/mobile-h5/dist /usr/share/nginx/html/m
EXPOSE 80
