# 复制为 .env 后使用；.env 不入库。变量名一经使用禁止改名（CLAUDE.md 第 7 节）。

# --- Postgres（docker-compose.yml 与 deploy/migrations 共用）---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sage
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=sage

# --- SQLAlchemy / Alembic 连接串 ---
DATABASE_URL=postgresql+psycopg://sage:change_me_dev@localhost:5432/sage

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- 环境（dev / demo / prod）---
SAGE_ENV=dev
