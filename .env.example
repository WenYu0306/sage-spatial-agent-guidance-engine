# 复制为 .env 后使用；.env 不入库。变量名一经使用禁止改名（CLAUDE.md 第 7 节）。

# --- Postgres（docker-compose.yml 与 deploy/migrations 共用）---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sage
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=sage

# --- SQLAlchemy / Alembic 连接串 ---
DATABASE_URL=postgresql+psycopg://sage:change_me_dev@localhost:5432/sage

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- 环境（dev / demo / prod）---
SAGE_ENV=dev

# --- seed 演示运营账号口令（手册 7.2；仅 demo 数据准备用，后台登录演示前改成你自己的口令）---
SEED_DEMO_ADMIN_PASSWORD=change_me_demo

# --- LLM Provider（M5 chat；OpenAI 兼容，不填 key 则管线用 mock 向量可测）---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini

# --- Embedding Provider（M6 检索；独立供应商可配，缺省回落 LLM_*）---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBED_BATCH_SIZE=10
EMBED_DIM=1024
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_DAILY_LIMIT=200

# M1 认证（JWT）。secret 必须 >=32 字节（PyJWT 会对短密钥告警）；
# access 2h / refresh 7d；登出黑名单用 REDIS_URL（不可达自动降级内存）。
JWT_SECRET=change_me_demo_secret_0123456789abcdef
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_SECONDS=900
